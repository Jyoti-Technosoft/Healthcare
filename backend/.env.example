# Database Configuration (Supabase PostgreSQL)
# Direct connection string format:
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require

# Supabase default DB user is postgres
SPRING_DATASOURCE_USERNAME=postgres

# Database password set when creating your Supabase project
SPRING_DATASOURCE_PASSWORD=your_supabase_db_password

# Database schema strategy (update, validate, none)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Maximum connection pool size (recommended 5-10 for Supabase free tier connection limits)
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5

# Server Port (Render sets $PORT automatically, defaults to 8082 locally)
PORT=8082

# Frontend URL allowed for CORS
SPRING_WEB_CORS_ALLOWED_ORIGINS=https://your-frontend-app.onrender.com
