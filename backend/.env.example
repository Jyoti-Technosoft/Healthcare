# Database Configuration (Supabase PostgreSQL Pooler - IPv4 compatible for Render)
# Format 1 (Supabase Pooler on Port 6543 / Session Mode - Recommended for Render):
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?prepareThreshold=0&sslmode=require

# Format 2 (Supabase Direct Host on Port 5432):
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require

# Supabase default DB user (Note: for Pooler mode, user format is postgres.<project-ref>)
SPRING_DATASOURCE_USERNAME=postgres.<your-project-ref>

# Database password set when creating your Supabase project
SPRING_DATASOURCE_PASSWORD=your_supabase_db_password

# Database schema strategy (update, validate, none)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Maximum connection pool size (recommended 3-5 for Supabase pooler connections)
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5

# Server Port (Render sets $PORT automatically, defaults to 8082 locally)
PORT=8082

# Frontend URL allowed for CORS
SPRING_WEB_CORS_ALLOWED_ORIGINS=https://healthcare-frontend.onrender.com
